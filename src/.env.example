# Copy to .env in this directory. Both keys are optional: without them the
# corresponding feature is skipped, and all local C2PA and EXIF inspection
# still works.

# Google Gemini API key. Enables the AI assessment offered when an image
# carries no Content Credentials. The image is uploaded to that API, and the
# app asks before doing so.
GOOGLE_API_KEY=

# SerpAPI key. Used by reverse image search. Without it the app falls back to
# direct uploads to the search engines. A key can also be entered in the app.
SERPAPI=
